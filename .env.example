# Copy to .env and edit. Node does not load .env automatically; run with:
#   node --env-file=.env dist/server.js
# Every value is optional; the defaults are shown.

# ---- Compact AI (src/config/compact-config.ts) ----
# JSON config file (model size, training, generation, server)
LCAI_CONFIG=compact.config.json
# Corpus used by "npm run train" (and by the server when no model is saved)
CORPUS=data/corpus.txt
# Training passes for "npm run train"
EPOCHS=40
LCAI_LEARNING_RATE=0.003
# Where the trained model is saved and loaded from
MODEL_PATH=models/compact.checkpoint.json
# Default reply length in tokens
LCAI_MAX_TOKENS=24
# HTTP server port
PORT=3000
# Training passes when the server starts with no saved model
LCAI_STARTUP_EPOCHS=15
# Chat settings saved by /settings (temperature, top-k, theme, ...)
LCAI_SETTINGS=.lcai/settings.json

# ---- Runtime services (src/config/runtime-config.ts) ----
NODE_ENV=development
LCAI_SERVICE_NAME=light-compact-ai
LCAI_MODEL_PRECISION=fp32
LCAI_MAX_CONTEXT_TOKENS=10000
LCAI_MAX_BATCH_SIZE=8
LCAI_CACHE_MAX_BYTES=268435456
LCAI_CACHE_TTL_MS=0
LCAI_CRON_ENABLED=true
LCAI_CRON_POLL_MS=15000
TZ=UTC

# ---- MySQL greeting/response cache ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lcai
MYSQL_PASSWORD=
MYSQL_DATABASE=light_compact_ai
MYSQL_CONNECTION_LIMIT=10
