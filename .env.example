# Copy to .env and edit. "npm run chat" and "npm start" load .env automatically
# (set LCAI_ENV_FILE to use another file). Never commit .env; it is gitignored.
# Every value is optional; the defaults are shown.

# ---- Voice: Aurora text-to-speech (src/voice/voice.ts) ----
# ElevenLabs: https://elevenlabs.io -> Profile -> API keys
ELEVENLABS_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Azure Speech: Azure portal -> Speech resource -> Keys and Endpoint (both needed)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Play.ht: its API host stopped resolving in 2025; kept as the last fallback
PLAYHT_API_KEY=
PLAYHT_USER_ID=
# Provider tried first: elevenlabs, openai, azure or playht (/settings can change it).
# With fallback on, the others are tried in that order; ones without keys are skipped.
LCAI_VOICE_PROVIDER=elevenlabs
# Try the other provider if the first fails
LCAI_VOICE_FALLBACK=true
# Voice style preset
LCAI_VOICE_PRESET=aurora
# Optional overrides: any stock voice, or a voice you own
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
OPENAI_TTS_VOICE=
OPENAI_TTS_MODEL=
AZURE_SPEECH_VOICE=
PLAYHT_VOICE_ID=
PLAYHT_VOICE_ENGINE=
# Audio player command (file path appended); default is built in per OS
LCAI_AUDIO_PLAYER=

# ---- Compact AI (src/config/compact-config.ts) ----
# JSON config file (model size, training, generation, server)
LCAI_CONFIG=compact.config.json
# Corpus used by "npm run train" (and by the server when no model is saved)
CORPUS=data/corpus.txt
# Training passes for "npm run train"
EPOCHS=40
LCAI_LEARNING_RATE=0.003
# Where the trained model is saved and loaded from
MODEL_PATH=models/compact.checkpoint.json
# Default reply length in tokens
LCAI_MAX_TOKENS=24
# HTTP server port
PORT=3000
# Training passes when the server starts with no saved model
LCAI_STARTUP_EPOCHS=15
# Chat settings saved by /settings (temperature, top-k, theme, ...)
LCAI_SETTINGS=.lcai/settings.json

# ---- Runtime services (src/config/runtime-config.ts) ----
NODE_ENV=development
LCAI_SERVICE_NAME=light-compact-ai
LCAI_MODEL_PRECISION=fp32
LCAI_MAX_CONTEXT_TOKENS=10000
LCAI_MAX_BATCH_SIZE=8
LCAI_CACHE_MAX_BYTES=268435456
LCAI_CACHE_TTL_MS=0
LCAI_CRON_ENABLED=true
LCAI_CRON_POLL_MS=15000
TZ=UTC

# ---- MySQL greeting/response cache ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lcai
MYSQL_PASSWORD=
MYSQL_DATABASE=light_compact_ai
MYSQL_CONNECTION_LIMIT=10
