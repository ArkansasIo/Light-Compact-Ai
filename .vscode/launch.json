{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train model",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "npm: build",
      "program": "${workspaceFolder}/dist/cli/train.js",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    },
    {
      "name": "Run server",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "npm: build",
      "program": "${workspaceFolder}/dist/server.js",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    },
    {
      "name": "Chat",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "npm: build",
      "program": "${workspaceFolder}/dist/cli/chat.js",
      "console": "integratedTerminal",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
