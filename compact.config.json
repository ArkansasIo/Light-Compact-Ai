{
  "model": {
    "dModel": 32,
    "numHeads": 4,
    "dFeedForward": 64,
    "numLayers": 2,
    "maxSequenceLength": 32,
    "seed": 7
  },
  "training": {
    "corpus": "data/corpus.txt",
    "epochs": 40,
    "learningRate": 0.003,
    "output": "models/compact.checkpoint.json"
  },
  "generation": {
    "maxTokens": 24
  },
  "server": {
    "port": 3000,
    "startupEpochs": 15
  },
  "voice": {
    "preset": "aurora",
    "provider": "elevenlabs",
    "fallback": true,
    "maxChars": 1000,
    "elevenlabs": {
      "settings": {
        "stability": 0.35,
        "similarity_boost": 0.8,
        "style": 0.4,
        "speed": 0.92
      }
    },
    "playht": {
      "speed": 0.9,
      "temperature": 0.7
    }
  }
}
